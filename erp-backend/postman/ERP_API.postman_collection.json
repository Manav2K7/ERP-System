            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Laptop\",\n  \"sku\": \"LAP-001\",\n  \"category\": \"Electronics\",\n  \"unitPrice\": 999.99,\n  \"currentStock\": 50,\n  \"reorderLevel\": 10\n}"
